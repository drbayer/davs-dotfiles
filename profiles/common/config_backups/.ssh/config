# Control Master is optional: if this is missing, 'bastion' will not attempt to do anything fancy
# If ControlMaster is enabled (with this exact config), then 'bastion' will automatically background an ssh connection for you
## and continue to send you to the connections that you already have open (rather than creating a new one)
# This is disabled by default due to issues with mssh/cssh (below)
#Host *bssh*
#    ControlMaster auto
#    ControlPath ~/.ssh/master-%r@%h:%p
Host *prod *prod.linkedin.com *prod.linkedin.com. *stg *stg.linkedin.com *stg.linkedin.com. *app*.corp *app*.corp.linkedin.com *app*.corp.linkedin.com. *int *int.linkedin.com *int.linkedin.com.
    ProxyCommand ssh -A -T eng-portal.corp.linkedin.com nc %h %p
    ForwardAgent yes
    StrictHostKeyChecking no

# If you use or plan to use Hadoop at the CLI (from http://go/gridssh)
Host *.grid *.grid.linkedin.com *.grid.linkedin.com.
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes
    ForwardAgent yes
    ProxyCommand ssh -K -A -T grid-portal.corp.linkedin.com -W %h %p
 
# ControlPersist must never be set to 0 or more than 8 hours
Host grid-portal* eng-portal*
    ControlMaster auto
    ControlPath ~/.ssh/master-%r@%h:%p
    ControlPersist 8h
 
# ControlPersist must never be set to 0 or more than 8 hours
Host *bssh*
    ControlMaster auto
    ControlPath ~/.ssh/master-%r@%h:%p
    ControlPersist 8h

Host linuxbox lb ld1 dbayer-ld1
    HostName dbayer-ld1
    IdentityFile %d/.ssh/%u-ld1

Host *
    IdentityFile 	%d/.ssh/%u_at_linkedin.com_ssh_key
    #PubkeyAcceptedKeyTypes +ssh-dss
    #HostkeyAlgorithms +ssh-dss
    #AddKeysToAgent yes
    #UseKeyChain yes
    Ciphers aes128-ctr,aes192-ctr,aes256-ctr,aes128-cbc,3des-cbc

    # Canonicalizing host name allows you to type ltx1-holdemgw01
    # if you want to go to ltx1-holdemgw01.grid.linkedin.com
    CanonicalizeHostname yes
    CanonicalDomains grid.linkedin.com
    CanonicalizeFallbackLocal yes


